<Window x:Class="CycnyAPtakyWpf.PotvrzeniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jsi si jistý?" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" Background="#2D2D30">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Jsi si fakt jistý/á?!" FontSize="20" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <!-- Canvas jako hřiště pro utíkající tlačítko ANO a pevné NE -->
        <Canvas x:Name="hlavniPlatno" Grid.Row="1" Background="#1E1E1E">

            <!-- Tlačítko NE (Stojí pevně – kliknutí spustí smích) -->
            <Button Content="NE" Width="90" Height="40" FontSize="14" FontWeight="Bold"
                    Background="#F44336" Foreground="White"
                    Canvas.Left="50" Canvas.Top="100"
                    Click="BtnNe_Click"/>

            <!-- Tlačítko ANO (UTÍKÁ PŘED MYŠÍ) -->
            <Button x:Name="btnAno" Content="ANO" Width="90" Height="40" FontSize="14" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White"
                    Canvas.Left="220" Canvas.Top="100"
                    MouseEnter="BtnAno_MouseEnter"/>
        </Canvas>
    </Grid>
</Window>